# ========================================================
# Apache Configuration: Alokito Gour News Portal Clone
# ========================================================

Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block sensitive system files and documentation from public HTTP access
    RewriteRule ^(\.git|setup\.sql|\.env|.*\.md|.*\.sqlite) - [F,L,NC]

    # Clean URL for Single News: /news/{id}/{slug} -> single.php?id=$1&slug=$2
    RewriteRule ^news/([0-9]+)/?([^/]+)?/?$ single.php?id=$1&slug=$2 [L,QSA]

    # Clean URL for Category: /category/{slug} -> category.php?slug=$1
    RewriteRule ^category/([^/]+)/?$ category.php?slug=$1 [L,QSA]

    # Clean URL for Search: /search -> search.php
    RewriteRule ^search/?$ search.php [L,QSA]
    # Clean URL for Area News Filter: /area -> area.php
    RewriteRule ^area/?$ area.php [L,QSA]

    # Clean URL for Page Builder Pages: /page/{slug} -> page.php?slug=$1
    RewriteRule ^page/([^/]+)/?$ page.php?slug=$1 [L,QSA]

    # Standard Fallback for real files & directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>

# ========================================================
# Gzip Compression (mod_deflate)
# ========================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# ========================================================
# Browser Caching Headers (mod_expires)
# ========================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# UTF-8 Charset
AddDefaultCharset UTF-8
